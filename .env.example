# VoyageVerse Environment Variables
# Copy this file to .env and fill in your actual API keys

# Amadeus API (Flights, Hotels, Cars)
# Get your API key from: https://developers.amadeus.com/
REACT_APP_AMADEUS_API_KEY=your_amadeus_api_key_here
REACT_APP_AMADEUS_API_SECRET=your_amadeus_api_secret_here

# Expedia Group API (Experiences)
# Get your API key from: https://developer.expediagroup.com/
REACT_APP_EXPEDIA_API_KEY=your_expedia_api_key_here

# OpenTable API (Restaurants)
# Get your API key from: https://www.opentable.com/account/api-credentials
REACT_APP_OPENTABLE_API_KEY=your_opentable_api_key_here

# Google Maps Platform APIs (Places, Geocoding)
# Get your API key from: https://developers.google.com/maps/apis-list
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Stripe API (Payments)
# Get your API keys from: https://dashboard.stripe.com/apikeys
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Application Configuration
REACT_APP_API_BASE_URL=http://localhost:3000/api
REACT_APP_APP_NAME=VoyageVerse
REACT_APP_APP_VERSION=1.0.0

# Database Configuration (if using backend)
DATABASE_URL=postgresql://username:password@localhost:5432/voyageverse
REDIS_URL=redis://localhost:6379

# JWT Configuration (if using backend authentication)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password_here

# Analytics (optional)
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=your_mixpanel_token_here

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_WHITE_LABEL=true

# Development Settings
NODE_ENV=development
REACT_APP_DEBUG=true
